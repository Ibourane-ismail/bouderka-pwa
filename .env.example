# ============================================================
# Bouderka PWA — Variables d'environnement (exemple)
# Copier ce fichier en `.env` (dans server/) et renseigner
# de vraies valeurs. Ne jamais commit le fichier `.env` réel.
# ============================================================

# --- Base de données (server/prisma/schema.prisma) ---
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# --- Authentification JWT (server/src/middlewares/auth.middleware.js, server/src/controllers/auth.controller.js) ---
JWT_SECRET="your_jwt_secret"
JWT_REFRESH_SECRET="your_refresh_secret"

# --- Serveur Express (server/server.js) ---
PORT=5000
# development | production — influence le rate limiting, les cookies "secure" et le niveau de détail des erreurs
NODE_ENV=development

# --- CORS / URL du frontend (server/server.js) ---
CLIENT_URL="http://localhost:5173"
